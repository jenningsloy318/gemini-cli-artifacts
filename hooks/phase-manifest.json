{
  "version": "1.1.0",
  "description": "Maps super-dev agent types to required prerequisite artifacts from previous phases. Uses glob patterns (*-doctype.md) for dynamic incremental naming.",
  "gates": {
    "super-dev:bdd-scenario-writer": {
      "phase": "2.5",
      "description": "BDD Scenario Writing requires completed requirements",
      "requires": ["[doc-index]-requirements.md"],
      "sections": {
        "[doc-index]-requirements.md": ["Acceptance Criteria"]
      }
    },
    "super-dev:research-agent": {
      "phase": "3",
      "description": "Research requires completed requirements and BDD scenarios",
      "requires": ["[doc-index]-requirements.md", "[doc-index]-scenarios.md"],
      "sections": {
        "[doc-index]-scenarios.md": ["Given"]
      }
    },
    "super-dev:debug-analyzer": {
      "phase": "4",
      "description": "Debug analysis requires completed requirements",
      "requires": ["[doc-index]-requirements.md"],
      "sections": {}
    },
    "super-dev:code-assessor": {
      "phase": "5",
      "description": "Code assessment requires research report",
      "requires": ["[doc-index]-research.md"],
      "sections": {}
    },
    "super-dev:architecture-agent": {
      "phase": "5.3",
      "description": "Architecture design requires assessment",
      "requires": ["[doc-index]-assessment.md"],
      "sections": {}
    },
    "super-dev:product-designer": {
      "phase": "5.4",
      "description": "Product design requires assessment",
      "requires": ["[doc-index]-assessment.md"],
      "sections": {}
    },
    "super-dev:ui-ux-designer": {
      "phase": "5.5",
      "description": "UI/UX design requires assessment",
      "requires": ["[doc-index]-assessment.md"],
      "sections": {}
    },
    "super-dev:spec-writer": {
      "phase": "6",
      "description": "Spec writing requires assessment and design documents",
      "requires": ["[doc-index]-assessment.md"],
      "sections": {}
    },
    "super-dev:dev-executor": {
      "phase": "8",
      "description": "Execution requires complete specification, plan, and task list",
      "requires": [
        "[doc-index]-specification.md",
        "[doc-index]-plan.md",
        "[doc-index]-task-list.md"
      ],
      "sections": {
        "[doc-index]-specification.md": ["Technical Design"],
        "[doc-index]-task-list.md": ["Tasks"]
      }
    },
    "super-dev:qa-agent": {
      "phase": "8",
      "description": "QA requires complete specification and BDD scenarios",
      "requires": ["[doc-index]-specification.md", "[doc-index]-scenarios.md"],
      "sections": {}
    },
    "super-dev:code-reviewer": {
      "phase": "9",
      "description": "Code review requires specification",
      "requires": ["[doc-index]-specification.md"],
      "sections": {}
    },
    "super-dev:adversarial-reviewer": {
      "phase": "9",
      "description": "Adversarial review requires specification",
      "requires": ["[doc-index]-specification.md"],
      "sections": {}
    },
    "super-dev:docs-executor": {
      "phase": "10",
      "description": "Documentation requires specification and implementation summary",
      "requires": ["[doc-index]-specification.md"],
      "sections": {}
    },
    "super-dev:handoff-writer": {
      "phase": "10.5",
      "description": "Handoff requires specification directory with all artifacts",
      "requires": ["[doc-index]-specification.md"],
      "sections": {}
    }
  }
}
